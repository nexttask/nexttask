{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttask",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexttask-db",
      "database_id": "nexttask-db"
    }
  ]
}
