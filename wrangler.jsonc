{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttask",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexttask-db",
      "database_id": "6a20da5c-1ce5-4b57-bf88-496ed2301ee7"
    }
  ]
}
